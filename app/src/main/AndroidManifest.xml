<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ここにカメラ権限を追加します -->
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature android:name="android.hardware.camera" android:required="true" />

    <!-- 棚卸: 溜めた読み取りをサーバへ送るため（送信は電波が戻ったときだけ） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 棚卸: 読めたことを手に伝えるため（倉庫では音が聞こえないことがある） -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- オートフォーカスも必須なら追加 -->
    <!-- <uses-feature android:name="android.hardware.camera.autofocus" android:required="true" /> -->



    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TestApp001">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 棚卸: 読む前に 部署・棚卸日・棚名 を決める -->
        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:label="@string/setup_title" />

        <!-- 棚卸: 端末に溜まっている読み取りの一覧 -->
        <!-- 棚卸: 既存のログイン画面を WebView で出して Cookie を借りる -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:label="@string/login_title" />

        <activity
            android:name=".ScanListActivity"
            android:exported="false"
            android:label="@string/list_title" />
    </application>

</manifest>