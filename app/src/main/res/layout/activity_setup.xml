<?xml version="1.0" encoding="utf-8"?>
<!-- 読む前に「版（既存から選ぶ）・棚名・担当」を決める画面 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_note"
            android:textSize="13sp"
            android:paddingBottom="16dp" />

        <!-- 版（サーバにある版から選ぶ。端末からは作らない） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_ver"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/ver_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <Button
            android:id="@+id/btn_pick_ver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_pick_ver" />

        <!-- 棚名 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_tana"
            android:textSize="14sp"
            android:paddingTop="16dp" />

        <EditText
            android:id="@+id/in_tana"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textSize="20sp"
            android:hint="@string/setup_tana_hint"
            android:autofillHints=""
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/btn_pick_tana"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_pick_tana" />

        <!-- 担当者 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_tnt"
            android:textSize="14sp"
            android:paddingTop="12dp" />

        <EditText
            android:id="@+id/in_tnt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textSize="20sp"
            android:hint="@string/setup_tnt_hint"
            android:autofillHints=""
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/btn_pick_tnt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_pick_tnt" />

        <TextView
            android:id="@+id/setup_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:paddingTop="20dp" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_save"
            android:textSize="18sp"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
